# =============================================================================
# Voice FAQ Agent — POC environment (local-first; telephony simulated)
# Copy this file to `.env` and fill it in. `.env` is gitignored.
# POC scope: 3 cloud sign-ups (Deepgram, Groq, ElevenLabs); everything else local.
# Cost flags: [FREE] [FREE-TIER] [PAID]
# =============================================================================

# ── Cloud APIs you must sign up for (the only 3 for the POC) ──────────────────

# 1. DEEPGRAM  [free credit] — streaming STT (Nova-3)
#    https://console.deepgram.com/signup  →  API Keys
DEEPGRAM_API_KEY=

# 2. GROQ  [FREE-TIER] — LLM synthesis (Llama-3.3-70B-versatile)
#    https://console.groq.com/  →  API Keys
GROQ_API_KEY=

# 3. ELEVENLABS  [PAID] — streaming TTS (pick an Indian-English voice)
#    https://elevenlabs.io/  →  Profile → API Key; browse the Voice Library for a voice id
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                     # Indian-English voice id from the Voice Library
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5    # verify the current low-latency model name

# Optional LLM fallback (NOT needed for the POC):
# GEMINI_API_KEY=

# ── Local services (via docker-compose — no sign-up) ─────────────────────────
OPENSEARCH_URL=http://localhost:9200
POSTGRES_URL=postgresql://voicefaq:voicefaq@localhost:55432/voicefaq   # 55432 avoids clashing with a 5432 already in use

# ── Local paths & toggles ────────────────────────────────────────────────────
AUDIO_DIR=./data/audio                   # pre-synth + cached audio (replaces R2 for POC)
TRANSCRIPT_DIR=./data/transcripts        # redacted transcripts (replaces R2 for POC)
SHADOW_DB=./data/shadow.sqlite           # SQLite shadow log (no Postgres drain in POC)
AB_VARIANT=auto                          # lexical | semantic | auto | lexical_only
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # local HuggingFace model, NO key
RERANKER_MODEL=BAAI/bge-reranker-base    # local HuggingFace model, NO key (v2-m3 = heavier prod option)
VFA_REAL_MODELS=0                        # 1 -> use real BGE models (needs the 3.12 venv)
